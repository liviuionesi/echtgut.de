# Copy to secrets.env (gitignored) and fill in real values before applying
# this overlay. On a real deploy these normally come from Terraform
# outputs / a secret manager rather than a hand-filled file — this
# template exists for the manual/demo path (`kubectl apply -k`), and for
# local `kustomize build` validation.

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME

# HS256 shared secret the backend uses to sign/validate curator JWTs.
JWT_SECRET=CHANGE_ME
