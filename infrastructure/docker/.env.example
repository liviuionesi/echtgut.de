# Copy to .env (gitignored) in this directory before `docker compose up`.
POSTGRES_DB=echtgut
POSTGRES_USER=admin
POSTGRES_PASSWORD=devpassword
POSTGRES_PORT=5432

BACKEND_PORT=8080
JWT_SECRET=devsecret-change-me

# Optional dev-tools profile (docker compose --profile dev-tools up -d)
ADMINER_PORT=9081

# Optional sonar profile (docker compose --profile sonar up -d)
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
SONAR_DB_NAME=sonar
SONAR_HOST_PORT=9010
