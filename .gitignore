# --- Backend (Gradle/Java) ---
backend/.gradle/
backend/build/
backend/**/build/
!backend/**/src/**/build/
*.class
*.jar
!gradle/wrapper/*.jar

# --- Frontend (Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local

# --- Terraform ---
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example
infrastructure/terraform/**/.terraform.lock.hcl
infrastructure/terraform/**/crash.log

# --- Kubernetes / Kustomize secrets ---
infrastructure/kubernetes/**/secrets.env
!infrastructure/kubernetes/**/secrets.env.example

# --- Docker Compose local data / env ---
infrastructure/docker/.env
infrastructure/docker/models/

# --- Autonomous dev contract (see CLAUDE.md) ---
.claude/.autonomous-lock
.claude/.autonomous-halt

# --- Claude Code harness-local session state (not project content) ---
.claude/scheduled_tasks.lock

# --- General ---
.DS_Store
*.log
.env
.env.local
.idea/
.vscode/
*.iml
